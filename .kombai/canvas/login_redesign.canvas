  "nodes": {
    "var_e31f9528b8ab": {
      "type": "variant",
      "label": "Login - Formulario Directo y Culinario",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  .font-display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n  .font-sans {\n    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n  }\n</style>\n<div class=\"w-[390px] min-h-[844px] bg-[#FCF9F5] text-[#242120] font-sans flex flex-col justify-between selection:bg-[#8E292E]/10 selection:text-[#8E292E] relative overflow-hidden\" data-kid=\"1\" data-name=\"login screen mobile layout\">\n<!-- Content Area -->\n<div class=\"flex-1 flex flex-col\" data-kid=\"1-1\" data-name=\"main content column\">\n<!-- Compact Culinary Header (132px) -->\n<div class=\"relative w-full h-[132px] overflow-hidden bg-[#7A1C23]\" data-kid=\"1-1-1\" data-name=\"culinary header banner\">\n<img alt=\"Nano Erdozain on Pexels\" class=\"w-full h-full object-cover object-center opacity-85 scale-105\" data-kid=\"1-1-1-1\" data-name=\"header background photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/28503586/pexels-photo-28503586.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n<!-- Warm culinary gradient overlay -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#1F0A0D]/90 via-[#7A1C23]/40 to-transparent\" data-kid=\"1-1-1-2\" data-name=\"gradient overlay on header image\"></div>\n<!-- Brand overlay -->\n<div class=\"absolute bottom-3 left-6 right-6 flex items-end justify-between\" data-kid=\"1-1-1-3\" data-name=\"brand identity overlay row\">\n<div data-kid=\"1-1-1-3-1\" data-name=\"brand text group\">\n<span class=\"text-[#E3BD73] text-[10px] tracking-[0.2em] uppercase font-bold block mb-0.5\" data-kid=\"1-1-1-3-1-1\" data-name=\"brand tagline label\">Tradición &amp; Fusión</span>\n<h1 class=\"font-display text-2xl font-bold text-white tracking-wide leading-tight\" data-kid=\"1-1-1-3-1-2\" data-name=\"brand name headline\">Chifa ASIA</h1>\n</div>\n<div class=\"w-8 h-8 rounded-full bg-white/15 backdrop-blur-xs border border-white/25 flex items-center justify-center text-[#E3BD73]\" data-kid=\"1-1-1-3-2\" data-name=\"header icon badge circle\">\n<svg class=\"w-4 h-4\" data-kid=\"1-1-1-3-2-1\" data-name=\"chopsticks icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"m16 2-4 8 4 12\"></path>\n<path d=\"m8 2 4 8-4 12\"></path>\n</svg>\n</div>\n</div>\n</div>\n<!-- Main Form Area -->\n<div class=\"px-6 pt-5 pb-4 flex flex-col flex-1\" data-kid=\"1-1-2\" data-name=\"login form container\">\n<!-- Page Title & Subtitle -->\n<div class=\"mb-4\" data-kid=\"1-1-2-1\" data-name=\"page title and subtitle block\">\n<h2 class=\"font-display text-[27px] font-semibold text-[#242120] leading-tight\" data-kid=\"1-1-2-1-1\" data-name=\"login page title\">Iniciar sesión</h2>\n<p class=\"text-[13px] text-[#746F6A] mt-0.5\" data-kid=\"1-1-2-1-2\" data-name=\"login page subtitle text\">Ingresa tus credenciales para continuar tu experiencia culinaria</p>\n</div>\n<!-- Login Form -->\n<form class=\"space-y-3.5 flex-1\" data-kid=\"1-1-2-2\" data-name=\"sign-in form\" id=\"login-form\" onsubmit=\"event.preventDefault(); handleLoginSubmit();\">\n<!-- Email Field Group -->\n<div class=\"space-y-1.5\" data-kid=\"1-1-2-2-1\" data-name=\"email field group\">\n<div class=\"flex justify-between items-center\" data-kid=\"1-1-2-2-1-1\" data-name=\"field label row\">\n<label class=\"text-[13px] font-semibold text-[#242120]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"email field label\" for=\"email\">Correo electrónico</label>\n<span class=\"text-[11px] text-[#278063] font-medium hidden flex items-center gap-1 transition-opacity duration-200\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"email validity status indicator\" data-reason=\"class and text content toggled by validateEmailLive to show/hide validation state\" id=\"email-status\">\n<svg class=\"w-3.5 h-3.5\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n<polyline points=\"20 6 9 17 4 12\"></polyline>\n</svg>\n<span data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-2-2\" data-name=\"valid email status text\" data-reason=\"text content rewritten by validation script\">Formato válido</span>\n</span>\n</div>\n<div class=\"relative\" data-kid=\"1-1-2-2-1-2\" data-name=\"email input wrapper\">\n<div class=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#746F6A]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"email icon decoration container\">\n<svg class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"email envelope icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n<rect height=\"16\" rx=\"2\" width=\"20\" x=\"2\" y=\"4\"></rect>\n<path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path>\n</svg>\n</div>\n<input autocomplete=\"email\" class=\"w-full h-[50px] pl-10 pr-3.5 bg-white border border-[#E7DDD2] rounded-[10px] text-[14px] text-[#242120] placeholder-[#A09A93] focus:outline-hidden focus:border-[#8E292E] focus:ring-1 focus:ring-[#8E292E] transition-all duration-150\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"email input field\" id=\"email\" oninput=\"validateEmailLive(this.value)\" placeholder=\"cliente@ejemplo.com\" type=\"email\"/>\n</div>\n</div>\n<!-- Password Field Group -->\n<div class=\"space-y-1.5\" data-kid=\"1-1-2-2-2\" data-name=\"password field group\">\n<div class=\"flex justify-between items-center\" data-kid=\"1-1-2-2-2-1\" data-name=\"field label and link row\">\n<label class=\"text-[13px] font-semibold text-[#242120]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"password field label\" for=\"password\">Contraseña</label>\n<a class=\"text-[12px] text-[#8E292E] hover:text-[#7A1C23] font-medium transition-colors\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"forgot password link\" href=\"#recuperar\">¿Olvidaste tu contraseña?</a>\n</div>\n<div class=\"relative\" data-kid=\"1-1-2-2-2-2\" data-name=\"password input wrapper\">\n<div class=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#746F6A]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"lock icon decoration container\">\n<svg class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-2-2-2-1-1\" data-name=\"lock icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n<rect height=\"11\" rx=\"2\" ry=\"2\" width=\"18\" x=\"3\" y=\"11\"></rect>\n<path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path>\n</svg>\n</div>\n<input class=\"w-full h-[50px] pl-10 pr-11 bg-white border border-[#E7DDD2] rounded-[10px] text-[14px] text-[#242120] placeholder-[#A09A93] focus:outline-hidden focus:border-[#8E292E] focus:ring-1 focus:ring-[#8E292E] transition-all duration-150\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"password input field\" data-reason=\"type attribute toggled by togglePasswordVisibility\" id=\"password\" oninput=\"handlePasswordInput(this.value)\" placeholder=\"••••••••\" type=\"password\"/>\n<button aria-label=\"Mostrar contraseña\" class=\"absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#746F6A] hover:text-[#242120] transition-colors focus:outline-hidden\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"password visibility toggle button\" id=\"toggle-password\" onclick=\"togglePasswordVisibility()\" type=\"button\">\n<svg class=\"w-[19px] h-[19px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-3-1\" data-name=\"eye icon\" data-reason=\"class toggled by togglePasswordVisibility to hide/show\" fill=\"none\" id=\"eye-icon\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n<path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\"></path>\n<circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n</svg>\n<svg class=\"w-[19px] h-[19px] hidden\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-3-2\" data-name=\"eye-off icon\" data-reason=\"class toggled by togglePasswordVisibility to hide/show\" fill=\"none\" id=\"eye-off-icon\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n<path d=\"M9.88 9.88a3 3 0 1 0 4.24 4.24\"></path>\n<path d=\"M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68\"></path>\n<path d=\"M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61\"></path>\n<line x1=\"2\" x2=\"22\" y1=\"2\" y2=\"22\"></line>\n</svg>\n</button>\n</div>\n<!-- Password Live Strength Indicator -->\n<div class=\"pt-1 transition-all duration-200\" data-kid=\"1-1-2-2-2-3\" data-name=\"password strength indicator block\" id=\"password-meter-container\">\n<div class=\"flex items-center gap-1.5 mb-1\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"password strength bars row\">\n<div class=\"h-1.5 flex-1 rounded-full bg-[#E7DDD2] overflow-hidden\" data-kid=\"1-1-2-2-2-3-1-1\" data-name=\"strength bar 1 track\">\n<div class=\"h-full bg-transparent rounded-full transition-all duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-1-1-1\" data-name=\"strength bar 1 fill\" data-reason=\"background color and width set by password strength script\" id=\"bar-1\"></div>\n</div>\n<div class=\"h-1.5 flex-1 rounded-full bg-[#E7DDD2] overflow-hidden\" data-kid=\"1-1-2-2-2-3-1-2\" data-name=\"strength bar 2 track\">\n<div class=\"h-full bg-transparent rounded-full transition-all duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-1-2-1\" data-name=\"strength bar 2 fill\" data-reason=\"background color and width set by password strength script\" id=\"bar-2\"></div>\n</div>\n<div class=\"h-1.5 flex-1 rounded-full bg-[#E7DDD2] overflow-hidden\" data-kid=\"1-1-2-2-2-3-1-3\" data-name=\"strength bar 3 track\">\n<div class=\"h-full bg-transparent rounded-full transition-all duration-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-1-3-1\" data-name=\"strength bar 3 fill\" data-reason=\"background color and width set by password strength script\" id=\"bar-3\"></div>\n</div>\n</div>\n<div class=\"flex justify-between items-center text-[11px]\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"strength label row\">\n<span class=\"text-[#746F6A]\" data-kid=\"1-1-2-2-2-3-2-1\" data-name=\"strength indicator label\" id=\"strength-label\">Complejidad de contraseña</span>\n<span class=\"text-[#746F6A] font-medium\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3-2-2\" data-name=\"strength hint text\" data-reason=\"text and color rewritten by password strength script\" id=\"strength-hint\">Mínimo 6 caracteres</span>\n</div>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"pt-2 space-y-2.5\" data-kid=\"1-1-2-2-3\" data-name=\"action buttons group\">\n<!-- Primary Sign In Button -->\n<button class=\"w-full h-[52px] bg-[#8E292E] hover:bg-[#7A1C23] active:scale-[0.985] text-white font-semibold rounded-[10px] text-[14px] flex items-center justify-center gap-2 shadow-xs transition-all duration-150 cursor-pointer\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-1\" data-name=\"primary sign-in button\" data-reason=\"innerHTML replaced with spinner then restored by handleLoginSubmit\" id=\"submit-btn\" type=\"submit\">\n<span data-dynamic=\"true\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"sign-in button label text\" data-reason=\"text replaced by handleLoginSubmit script\">Iniciar sesión</span>\n<svg class=\"w-4 h-4\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<line x1=\"5\" x2=\"19\" y1=\"12\" y2=\"12\"></line>\n<polyline points=\"12 5 19 12 12 19\"></polyline>\n</svg>\n</button>\n<!-- Guest Explore Action -->\n<button class=\"w-full h-[48px] bg-white hover:bg-[#F5EFE7] active:scale-[0.985] border border-[#E7DDD2] text-[#242120] font-semibold rounded-[10px] text-[14px] flex items-center justify-between px-4 transition-all duration-150 cursor-pointer group\" data-kid=\"1-1-2-2-3-2\" data-name=\"guest explore button\" onclick=\"handleGuestClick()\" type=\"button\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-2-3-2-1\" data-name=\"button label row\">\n<div class=\"w-7 h-7 rounded-full bg-[#F5EFE7] text-[#C3934F] flex items-center justify-center group-hover:bg-[#8E292E]/10 group-hover:text-[#8E292E] transition-colors\" data-kid=\"1-1-2-2-3-2-1-1\" data-name=\"button icon background circle\">\n<svg class=\"w-3.5 h-3.5\" data-kid=\"1-1-2-2-3-2-1-1-1\" data-name=\"user silhouette icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"></path>\n<circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n</svg>\n</div>\n<span data-kid=\"1-1-2-2-3-2-1-2\" data-name=\"button label text\">Explorar como invitado</span>\n</div>\n<svg class=\"w-4 h-4 text-[#746F6A] group-hover:text-[#8E292E] group-hover:translate-x-0.5 transition-all\" data-kid=\"1-1-2-2-3-2-2\" data-name=\"chevron right arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<polyline points=\"9 18 15 12 9 6\"></polyline>\n</svg>\n</button>\n</div>\n</form>\n<!-- Bottom Register & Security Info -->\n<div class=\"mt-8 pt-4 border-t border-[#E7DDD2]/70 text-center space-y-3\" data-kid=\"1-1-2-3\" data-name=\"register and security info section\">\n<p class=\"text-[13px] text-[#746F6A]\" data-kid=\"1-1-2-3-1\" data-name=\"create account prompt text\">\n          ¿No tienes una cuenta? \n          <a class=\"text-[#8E292E] font-semibold hover:underline ml-1\" data-kid=\"1-1-2-3-1-1\" data-name=\"create account link\" href=\"#registro\">Crear cuenta</a>\n</p>\n<div class=\"flex items-center justify-center gap-1.5 text-[11px] text-[#746F6A]/80\" data-kid=\"1-1-2-3-2\" data-name=\"security notice row\">\n<svg class=\"w-3.5 h-3.5 text-[#278063]\" data-kid=\"1-1-2-3-2-1\" data-name=\"shield icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n<path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n</svg>\n<span data-kid=\"1-1-2-3-2-2\" data-name=\"secure connection notice text\">Conexión segura cifrada de punto a punto</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Safe Area Bottom Bar indicator (iOS style) -->\n<div class=\"h-7 w-full flex items-center justify-center pb-2\" data-kid=\"1-2\" data-name=\"iOS safe area home indicator\">\n<div class=\"w-32 h-1 bg-[#242120]/15 rounded-full\" data-kid=\"1-2-1\" data-name=\"home indicator bar\"></div>\n</div>\n</div>\n<script>\n  function validateEmailLive(val) {\n    const status = document.getElementById('email-status');\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (emailRegex.test(val.trim())) {\n      status.classList.remove('hidden');\n    } else {\n      status.classList.add('hidden');\n    }\n  }\n\n  function handlePasswordInput(val) {\n    const bar1 = document.getElementById('bar-1');\n    const bar2 = document.getElementById('bar-2');\n    const bar3 = document.getElementById('bar-3');\n    const hint = document.getElementById('strength-hint');\n\n    // Reset\n    bar1.className = 'h-full bg-transparent rounded-full transition-all duration-300';\n    bar2.className = 'h-full bg-transparent rounded-full transition-all duration-300';\n    bar3.className = 'h-full bg-transparent rounded-full transition-all duration-300';\n\n    if (!val || val.length === 0) {\n      hint.innerText = 'Mínimo 6 caracteres';\n      hint.className = 'text-[#746F6A] font-medium';\n      return;\n    }\n\n    if (val.length < 6) {\n      bar1.className = 'h-full bg-[#C35350] rounded-full transition-all duration-300 w-full';\n      hint.innerText = 'Complejidad: baja';\n      hint.className = 'text-[#C35350] font-medium';\n    } else if (val.length < 9) {\n      bar1.className = 'h-full bg-[#C3934F] rounded-full transition-all duration-300 w-full';\n      bar2.className = 'h-full bg-[#C3934F] rounded-full transition-all duration-300 w-full';\n      hint.innerText = 'Complejidad: media';\n      hint.className = 'text-[#C3934F] font-medium';\n    } else {\n      bar1.className = 'h-full bg-[#278063] rounded-full transition-all duration-300 w-full';\n      bar2.className = 'h-full bg-[#278063] rounded-full transition-all duration-300 w-full';\n      bar3.className = 'h-full bg-[#278063] rounded-full transition-all duration-300 w-full';\n      hint.innerText = 'Complejidad: alta';\n      hint.className = 'text-[#278063] font-medium';\n    }\n  }\n\n  function togglePasswordVisibility() {\n    const input = document.getElementById('password');\n    const eye = document.getElementById('eye-icon');\n    const eyeOff = document.getElementById('eye-off-icon');\n    const btn = document.getElementById('toggle-password');\n\n    if (input.type === 'password') {\n      input.type = 'text';\n      eye.classList.add('hidden');\n      eyeOff.classList.remove('hidden');\n      btn.setAttribute('aria-label', 'Ocultar contraseña');\n    } else {\n      input.type = 'password';\n      eye.classList.remove('hidden');\n      eyeOff.classList.add('hidden');\n      btn.setAttribute('aria-label', 'Mostrar contraseña');\n    }\n  }\n\n  function handleLoginSubmit() {\n    const btn = document.getElementById('submit-btn');\n    const originalText = btn.innerHTML;\n    btn.innerHTML = `\n      <svg class=\"animate-spin -ml-1 mr-2 h-4 w-4 text-white\" fill=\"none\" viewBox=\"0 0 24 24\">\n        <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n        <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n      </svg>\n      <span>Iniciando sesión...</span>\n    `;\n    btn.disabled = true;\n    setTimeout(() => {\n      btn.innerHTML = originalText;\n      btn.disabled = false;\n    }, 1800);\n  }\n\n  function handleGuestClick() {\n    console.log('Navegar a modo invitado');\n  }\n</script>",
