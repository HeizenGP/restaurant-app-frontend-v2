        "h": 0
      },
      "html": "<link data-kid=\"1\" data-name=\"font preconnect link\" href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" data-kid=\"2\" data-name=\"font preconnect link (crossorigin)\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link data-kid=\"3\" data-name=\"web font stylesheet link\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&amp;family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,400&amp;display=swap\" rel=\"stylesheet\"/>\n<link data-kid=\"4\" data-name=\"icon font stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\" rel=\"stylesheet\"/>\n<style>\n  :root {\n    --bg-page: #FCF9F5;\n    --surface-card: #FFFFFF;\n    --surface-tint: #F5EFE7;\n    --border-subtle: #E7DDD2;\n    --border-control: #E4DFD7;\n    --text-primary: #242120;\n    --text-secondary: #746F6A;\n    --brand-red: #8E292E;\n    --brand-red-hover: #752125;\n    --accent-gold: #C3934F;\n    --color-success: #278063;\n  }\n\n  body {\n    background-color: var(--bg-page);\n    color: var(--text-primary);\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .step-panel {\n    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.24s ease-out;\n  }\n\n  .step-hidden-left {\n    transform: translateX(-24px);\n    opacity: 0;\n    pointer-events: none;\n    position: absolute;\n    width: 100%;\n    visibility: hidden;\n  }\n\n  .step-hidden-right {\n    transform: translateX(24px);\n    opacity: 0;\n    pointer-events: none;\n    position: absolute;\n    width: 100%;\n    visibility: hidden;\n  }\n\n  .step-active {\n    transform: translateX(0);\n    opacity: 1;\n    pointer-events: auto;\n    position: relative;\n    width: 100%;\n    visibility: visible;\n  }\n\n  /* Custom input outline animation */\n  .custom-input:focus-within {\n    border-color: var(--brand-red);\n    box-shadow: 0 0 0 1px var(--brand-red);\n  }\n</style>\n<div class=\"min-h-[844px] w-[390px] mx-auto bg-[#FCF9F5] text-[#242120] flex flex-col justify-between px-7 pt-11 pb-8 relative overflow-hidden select-none box-border\" data-kid=\"5\" data-name=\"mobile login card container\">\n<!-- Top bar / Ambient Header -->\n<div class=\"w-full flex items-center justify-between mb-2\" data-kid=\"5-1\" data-name=\"top header bar\">\n<!-- Brand crest -->\n<div class=\"flex items-center gap-2.5\" data-kid=\"5-1-1\" data-name=\"brand crest logo group\">\n<div class=\"w-9 h-9 rounded-xl bg-[#8E292E] flex items-center justify-center shadow-xs\" data-kid=\"5-1-1-1\" data-name=\"brand monogram tile\">\n<span class=\"font-display text-white text-xl font-bold tracking-tight\" data-kid=\"5-1-1-1-1\" data-name=\"brand monogram character\">亞</span>\n</div>\n<div class=\"flex flex-col\" data-kid=\"5-1-1-2\" data-name=\"brand name and tagline block\">\n<span class=\"font-display text-lg font-bold tracking-wide text-[#242120] leading-tight\" data-kid=\"5-1-1-2-1\" data-name=\"restaurant brand name\">CHIFA ASIA</span>\n<span class=\"text-[10px] uppercase tracking-wider font-semibold text-[#C3934F]\" data-kid=\"5-1-1-2-2\" data-name=\"brand tagline text\">Cocina Contemporánea</span>\n</div>\n</div>\n<!-- Security badge / Status -->\n<div class=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F5EFE7] border border-[#E7DDD2]\" data-kid=\"5-1-2\" data-name=\"security status badge\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-[#278063]\" data-kid=\"5-1-2-1\" data-name=\"green status dot\"></span>\n<span class=\"text-[11px] font-medium text-[#746F6A]\" data-kid=\"5-1-2-2\" data-name=\"secure access status text\">Acceso Seguro</span>\n</div>\n</div>\n<!-- Main interactive flow container -->\n<div class=\"w-full flex-1 relative flex flex-col justify-center my-auto\" data-kid=\"5-2\" data-name=\"interactive login flow container\">\n<!-- ================= STEP 1: Correo Electrónico ================= -->\n<div class=\"step-panel step-active flex flex-col\" data-kid=\"5-2-1\" data-name=\"email entry step panel\" id=\"step-1\">\n<!-- Headline & Subtitle -->\n<div class=\"mb-7\" data-kid=\"5-2-1-1\" data-name=\"step one headline block\">\n<h1 class=\"font-display text-[32px] font-semibold text-[#242120] leading-none mb-2\" data-kid=\"5-2-1-1-1\" data-name=\"login step heading\">Iniciar sesión</h1>\n<p class=\"text-[13px] text-[#746F6A] leading-relaxed\" data-kid=\"5-2-1-1-2\" data-name=\"step one subtitle description\">\n          Ingresa tu correo para consultar tus reservas, mesas y pedidos recientes.\n        </p>\n</div>\n<!-- Form field -->\n<div class=\"flex flex-col gap-1.5 mb-5\" data-kid=\"5-2-1-2\" data-name=\"email form field group\">\n<label class=\"text-[12px] font-semibold text-[#242120] tracking-wide\" data-kid=\"5-2-1-2-1\" data-name=\"email field label\" for=\"input-email\">\n          Correo electrónico\n        </label>\n<div class=\"custom-input relative flex items-center bg-white border border-[#E7DDD2] rounded-xl transition-all duration-150 h-[52px] px-3.5\" data-kid=\"5-2-1-2-2\" data-name=\"email input container\">\n<i class=\"icon-mail text-[#746F6A] text-lg mr-2.5 shrink-0\" data-kid=\"5-2-1-2-2-1\" data-name=\"envelope icon\"></i>\n<input autocomplete=\"email\" class=\"w-full bg-transparent border-none text-[14px] text-[#242120] placeholder-[#746F6A]/50 focus:outline-hidden\" data-kid=\"5-2-1-2-2-2\" data-name=\"email address input field\" id=\"input-email\" placeholder=\"ejemplo@correo.com\" type=\"email\" value=\"ana@example.com\"/>\n<div class=\"shrink-0 text-[#278063] flex items-center gap-1 transition-opacity duration-150\" data-kid=\"5-2-1-2-2-3\" data-name=\"email valid indicator\" id=\"email-valid-indicator\">\n<svg class=\"w-4 h-4\" data-kid=\"5-2-1-2-2-3-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n<path d=\"M5 13l4 4L19 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\"></path>\n</svg>\n</div>\n</div>\n<div class=\"hidden text-[11px] text-[#8E292E] font-medium pl-1 mt-0.5\" data-kid=\"5-2-1-2-3\" data-name=\"email error message\" id=\"email-error-msg\">\n          Por favor ingresa un correo electrónico válido.\n        </div>\n</div>\n<!-- Primary Action -->\n<button class=\"w-full h-[54px] rounded-xl bg-[#8E292E] hover:bg-[#752125] active:scale-[0.99] text-white text-[14px] font-semibold transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer shadow-sm shadow-[#8E292E]/20\" data-kid=\"5-2-1-3\" data-name=\"primary continue button\" id=\"btn-step1-continue\" type=\"button\">\n<span data-kid=\"5-2-1-3-1\" data-name=\"continue button label\">Continuar</span>\n<i class=\"icon-chevron-right text-base\" data-kid=\"5-2-1-3-2\" data-name=\"chevron right icon\"></i>\n</button>\n<!-- Secondary Entry: Guest & Register -->\n<div class=\"mt-6 pt-5 border-t border-[#E7DDD2]/70 flex flex-col gap-2.5\" data-kid=\"5-2-1-4\" data-name=\"secondary entry actions panel\">\n<button class=\"w-full h-[48px] rounded-xl bg-[#F5EFE7] hover:bg-[#ECE3D7] active:bg-[#E4D8C8] text-[#242120] text-[13px] font-semibold px-4 flex items-center justify-between transition-colors border border-[#E7DDD2]\" data-kid=\"5-2-1-4-1\" data-name=\"guest access button\" id=\"btn-guest-access\" type=\"button\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"5-2-1-4-1-1\" data-name=\"guest button label group\">\n<span class=\"w-7 h-7 rounded-lg bg-white flex items-center justify-center text-[#8E292E] shadow-2xs\" data-kid=\"5-2-1-4-1-1-1\" data-name=\"icon badge container\">\n<i class=\"icon-chef-hat text-sm\" data-kid=\"5-2-1-4-1-1-1-1\" data-name=\"chef hat icon\"></i>\n</span>\n<span data-kid=\"5-2-1-4-1-1-2\" data-name=\"guest button label text\">Explorar menú como invitado</span>\n</div>\n<i class=\"icon-chevron-right text-[#746F6A] text-sm\" data-kid=\"5-2-1-4-1-2\" data-name=\"chevron right icon\"></i>\n</button>\n<div class=\"flex items-center justify-center gap-1.5 pt-2 text-[13px] text-[#746F6A]\" data-kid=\"5-2-1-4-2\" data-name=\"register prompt row\">\n<span data-kid=\"5-2-1-4-2-1\" data-name=\"account prompt question text\">¿Aún no tienes cuenta?</span>\n<button class=\"text-[#8E292E] font-semibold hover:underline\" data-kid=\"5-2-1-4-2-2\" data-name=\"register link button\" type=\"button\">Regístrate aquí</button>\n</div>\n</div>\n</div>\n<!-- ================= STEP 2: Contraseña y Autenticación ================= -->\n<div class=\"step-panel step-hidden-right flex flex-col\" data-kid=\"5-2-2\" data-name=\"password and auth step panel\" id=\"step-2\">\n<!-- Back button & editable email badge -->\n<div class=\"flex items-center justify-between mb-4\" data-kid=\"5-2-2-1\" data-name=\"step two top navigation row\">\n<button class=\"inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#8E292E] hover:text-[#752125] py-1 cursor-pointer transition-colors\" data-kid=\"5-2-2-1-1\" data-name=\"back to email button\" id=\"btn-step2-back\" type=\"button\">\n<i class=\"icon-arrow-left text-base\" data-kid=\"5-2-2-1-1-1\" data-name=\"left arrow icon\"></i>\n<span data-kid=\"5-2-2-1-1-2\" data-name=\"back button label\">Volver al correo</span>\n</button>\n<span class=\"text-[11px] font-medium text-[#746F6A]\" data-kid=\"5-2-2-1-2\" data-name=\"step progress indicator text\">Paso 2 de 2</span>\n</div>\n<!-- Headline -->\n<div class=\"mb-4\" data-kid=\"5-2-2-2\" data-name=\"step two headline block\">\n<h1 class=\"font-display text-[30px] font-semibold text-[#242120] leading-none mb-2\" data-kid=\"5-2-2-2-1\" data-name=\"password step heading\">Ingresa tu contraseña</h1>\n<!-- Editable Email Pill -->\n<div class=\"inline-flex items-center gap-2 bg-[#F5EFE7] border border-[#E7DDD2] rounded-xl px-3 py-1.5 max-w-full\" data-kid=\"5-2-2-2-2\" data-name=\"editable email pill\">\n<i class=\"icon-mail text-[#746F6A] text-xs shrink-0\" data-kid=\"5-2-2-2-2-1\" data-name=\"envelope icon\"></i>\n<span class=\"text-[12px] font-medium text-[#242120] truncate\" data-dynamic=\"true\" data-kid=\"5-2-2-2-2-2\" data-name=\"email display text\" data-reason=\"text replaced by email value from previous step on navigation\" id=\"display-email-pill\">ana@example.com</span>\n<button class=\"text-[11px] font-bold text-[#8E292E] hover:underline shrink-0 ml-1 cursor-pointer\" data-kid=\"5-2-2-2-2-3\" data-name=\"change email button\" id=\"btn-change-email\" type=\"button\">\n            Cambiar\n          </button>\n</div>\n</div>\n<!-- Password Field with dynamic strength meter -->\n<div class=\"flex flex-col gap-1.5 mb-2\" data-kid=\"5-2-2-3\" data-name=\"password field group\">\n<label class=\"text-[12px] font-semibold text-[#242120] tracking-wide\" data-kid=\"5-2-2-3-1\" data-name=\"password field label\" for=\"input-password\">\n          Contraseña\n        </label>\n<div class=\"custom-input relative flex items-center bg-white border border-[#E7DDD2] rounded-xl transition-all duration-150 h-[52px] px-3.5\" data-kid=\"5-2-2-3-2\" data-name=\"password input container\">\n<i class=\"icon-lock text-[#746F6A] text-lg mr-2.5 shrink-0\" data-kid=\"5-2-2-3-2-1\" data-name=\"lock icon\"></i>\n<input autocomplete=\"current-password\" class=\"w-full bg-transparent border-none text-[14px] text-[#242120] placeholder-[#746F6A]/50 focus:outline-hidden\" data-kid=\"5-2-2-3-2-2\" data-name=\"password input field\" id=\"input-password\" placeholder=\"••••••••\" type=\"password\" value=\"correcta123\"/>\n<button class=\"shrink-0 p-1.5 text-[#746F6A] hover:text-[#242120] transition-colors cursor-pointer\" data-kid=\"5-2-2-3-2-3\" data-name=\"toggle password visibility button\" id=\"btn-toggle-password\" title=\"Mostrar u ocultar contraseña\" type=\"button\">\n<i class=\"icon-eye text-lg\" data-kid=\"5-2-2-3-2-3-1\" data-name=\"eye icon\" id=\"icon-eye-state\"></i>\n</button>\n</div>\n<!-- Live Password Strength Indicator (Clean & Professional) -->\n<div class=\"flex flex-col gap-1 mt-1\" data-kid=\"5-2-2-3-3\" data-name=\"password strength indicator\">\n<div class=\"flex items-center justify-between text-[11px]\" data-kid=\"5-2-2-3-3-1\" data-name=\"strength label row\">\n<span class=\"text-[#746F6A]\" data-kid=\"5-2-2-3-3-1-1\" data-name=\"strength meter caption\">Seguridad de la clave</span>\n<span class=\"font-semibold text-[#278063]\" data-dynamic=\"true\" data-kid=\"5-2-2-3-3-1-2\" data-name=\"strength complexity label\" data-reason=\"text and color class recalculated by complexity script on each input event\" id=\"strength-label\">Complejidad: alta</span>\n</div>\n<div class=\"w-full h-1.5 bg-[#E7DDD2] rounded-full overflow-hidden flex\" data-kid=\"5-2-2-3-3-2\" data-name=\"strength progress track\">\n<div class=\"h-full bg-[#278063] rounded-full transition-all duration-300 w-3/4\" data-dynamic=\"true\" data-kid=\"5-2-2-3-3-2-1\" data-name=\"strength progress bar\" data-reason=\"width and color recalculated from password complexity score\" id=\"strength-bar\"></div>\n</div>\n</div>\n</div>\n<!-- Recovery link -->\n<div class=\"flex justify-end mb-5\" data-kid=\"5-2-2-4\" data-name=\"reset link row\">\n<button class=\"text-[12px] text-[#8E292E] font-medium hover:underline cursor-pointer\" data-kid=\"5-2-2-4-1\" data-name=\"forgot password link button\" type=\"button\">\n          ¿Olvidaste tu contraseña?\n        </button>\n</div>\n<!-- Primary Action: Iniciar Sesión -->\n<button class=\"w-full h-[54px] rounded-xl bg-[#8E292E] hover:bg-[#752125] active:scale-[0.99] text-white text-[14px] font-semibold transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer shadow-sm shadow-[#8E292E]/20\" data-dynamic=\"true\" data-kid=\"5-2-2-5\" data-name=\"primary login submit button\" data-reason=\"background color class replaced by success class on submit\" id=\"btn-submit-login\" type=\"button\">\n<span data-dynamic=\"true\" data-kid=\"5-2-2-5-1\" data-name=\"submit button label\" data-reason=\"text replaced with loading and welcome messages by submit script\" id=\"submit-text\">Iniciar sesión</span>\n<svg class=\"hidden animate-spin h-5 w-5 text-white\" data-kid=\"5-2-2-5-2\" data-name=\"loading spinner icon\" fill=\"none\" id=\"submit-spinner\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n<path class=\"opacity-75\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\" fill=\"currentColor\"></path>\n</svg>\n</button>\n<!-- Feedback success notice toast (hidden by default) -->\n<div class=\"hidden mt-4 p-3.5 rounded-xl bg-[#278063]/10 border border-[#278063]/30 text-[#278063] flex items-center gap-2.5\" data-kid=\"5-2-2-6\" data-name=\"login success toast card\" id=\"login-success-card\">\n<i class=\"icon-check-circle text-lg shrink-0\" data-kid=\"5-2-2-6-1\" data-name=\"check circle icon\"></i>\n<div class=\"text-[12px] font-medium leading-tight\" data-kid=\"5-2-2-6-2\" data-name=\"success message text\">\n          ¡Credenciales verificadas! Accediendo a tu mesa...\n        </div>\n</div>\n</div>\n</div>\n<!-- Footer / Legal & Localized Note -->\n<div class=\"pt-4 text-center border-t border-[#E7DDD2]/50\" data-kid=\"5-3\" data-name=\"footer legal bar\">\n<p class=\"text-[11px] text-[#746F6A]\" data-kid=\"5-3-1\" data-name=\"copyright and brand footer text\">\n      Chifa ASIA · Tradición culinaria china-peruana\n    </p>\n</div>\n</div>\n<script>\n  (function() {\n    const step1 = document.getElementById('step-1');\n    const step2 = document.getElementById('step-2');\n    const emailInput = document.getElementById('input-email');\n    const emailError = document.getElementById('email-error-msg');\n    const emailIndicator = document.getElementById('email-valid-indicator');\n    const displayEmailPill = document.getElementById('display-email-pill');\n    const passwordInput = document.getElementById('input-password');\n    const btnContinue = document.getElementById('btn-step1-continue');\n    const btnBack = document.getElementById('btn-step2-back');\n    const btnChangeEmail = document.getElementById('btn-change-email');\n    const btnTogglePassword = document.getElementById('btn-toggle-password');\n    const iconEyeState = document.getElementById('icon-eye-state');\n    const strengthBar = document.getElementById('strength-bar');\n    const strengthLabel = document.getElementById('strength-label');\n    const btnSubmit = document.getElementById('btn-submit-login');\n    const submitText = document.getElementById('submit-text');\n    const submitSpinner = document.getElementById('submit-spinner');\n    const successCard = document.getElementById('login-success-card');\n\n    function isValidEmail(val) {\n      return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(val.trim());\n    }\n\n    // Live validation for email in step 1\n    emailInput.addEventListener('input', function() {\n      const val = emailInput.value.trim();\n      if (isValidEmail(val)) {\n        emailIndicator.classList.remove('opacity-0');\n        emailError.classList.add('hidden');\n      } else {\n        emailIndicator.classList.add('opacity-0');\n      }\n    });\n\n    // Go to Step 2\n    btnContinue.addEventListener('click', function() {\n      const emailVal = emailInput.value.trim();\n      if (!isValidEmail(emailVal)) {\n        emailError.classList.remove('hidden');\n        emailInput.focus();\n        return;\n      }\n      emailError.classList.add('hidden');\n      displayEmailPill.textContent = emailVal;\n\n      // Transition animation\n      step1.classList.remove('step-active');\n      step1.classList.add('step-hidden-left');\n\n      setTimeout(function() {\n        step2.classList.remove('step-hidden-right');\n        step2.classList.add('step-active');\n        passwordInput.focus();\n      }, 100);\n    });\n\n    // Go back to Step 1\n    function goToStep1() {\n      step2.classList.remove('step-active');\n      step2.classList.add('step-hidden-right');\n\n      setTimeout(function() {\n        step1.classList.remove('step-hidden-left');\n        step1.classList.add('step-active');\n        emailInput.focus();\n      }, 100);\n    }\n\n    btnBack.addEventListener('click', goToStep1);\n    btnChangeEmail.addEventListener('click', goToStep1);\n\n    // Toggle password visibility\n    btnTogglePassword.addEventListener('click', function() {\n      if (passwordInput.type === 'password') {\n        passwordInput.type = 'text';\n        iconEyeState.className = 'icon-eye-off text-lg';\n      } else {\n        passwordInput.type = 'password';\n        iconEyeState.className = 'icon-eye text-lg';\n      }\n    });\n\n    // Dynamic password complexity calculation\n    passwordInput.addEventListener('input', function() {\n      const pass = passwordInput.value;\n      let score = 0;\n      if (pass.length >= 6) score++;\n      if (pass.length >= 10) score++;\n      if (/[A-Z]/.test(pass) || /[0-9]/.test(pass)) score++;\n      if (/[^A-Za-z0-9]/.test(pass)) score++;\n\n      if (pass.length === 0) {\n        strengthBar.style.width = '0%';\n        strengthBar.className = 'h-full bg-gray-300 rounded-full transition-all duration-300';\n        strengthLabel.textContent = 'Mínimo 6 caracteres';\n        strengthLabel.className = 'font-medium text-[#746F6A]';\n      } else if (score <= 1) {\n        strengthBar.style.width = '28%';\n        strengthBar.className = 'h-full bg-[#8E292E] rounded-full transition-all duration-300';\n        strengthLabel.textContent = 'Complejidad: baja';\n        strengthLabel.className = 'font-semibold text-[#8E292E]';\n      } else if (score === 2) {\n        strengthBar.style.width = '60%';\n        strengthBar.className = 'h-full bg-[#C3934F] rounded-full transition-all duration-300';\n        strengthLabel.textContent = 'Complejidad: media';\n        strengthLabel.className = 'font-semibold text-[#C3934F]';\n      } else {\n        strengthBar.style.width = '100%';\n        strengthBar.className = 'h-full bg-[#278063] rounded-full transition-all duration-300';\n        strengthLabel.textContent = 'Complejidad: alta';\n        strengthLabel.className = 'font-semibold text-[#278063]';\n      }\n    });\n\n    // Iniciar sesión simulation\n    btnSubmit.addEventListener('click', function() {\n      submitText.textContent = 'Iniciando sesión...';\n      submitSpinner.classList.remove('hidden');\n      btnSubmit.disabled = true;\n      btnSubmit.classList.add('opacity-90');\n\n      setTimeout(function() {\n        submitSpinner.classList.add('hidden');\n        submitText.textContent = '¡Bienvenido!';\n        btnSubmit.classList.remove('bg-[#8E292E]', 'hover:bg-[#752125]');\n        btnSubmit.classList.add('bg-[#278063]');\n        successCard.classList.remove('hidden');\n      }, 850);\n    });\n  })();\n</script>",
      "comments": [],
      "created": "2026-11-02T05:38:18.935644+00:00",
      "modified": "2026-11-02T05:38:32.053163+00:00",
      "id": "var_9fc41fb5ee1c",
      "contentHeight": 844
    },
    "var_3343df8be8d9": {
      "type": "variant",
      "label": "Login - Exploración Culinaria y Panel On-Demand",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 980,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  .font-cormorant {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n  .font-dmsans {\n    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n  }\n\n  /* Animación suave para la hoja modal */\n  #login-modal-sheet {\n    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;\n  }\n  #login-backdrop {\n    transition: opacity 0.25s ease;\n  }\n</style>\n<div class=\"relative w-full h-[844px] bg-[#FCF9F5] text-[#242120] font-dmsans antialiased select-none overflow-hidden flex flex-col justify-between\" data-kid=\"1\" data-name=\"phone screen mockup container\">\n<!-- TOP PHONE STATUS BAR (44px) -->\n<header class=\"w-full px-6 pt-3 pb-2 flex items-center justify-between text-xs font-semibold text-[#242120]/80 tracking-tight z-10 shrink-0\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar time display\">9:41</span>\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-1-2\" data-name=\"status bar connectivity icons\">\n<i class=\"icon-signal text-[13px]\" data-kid=\"1-1-2-1\" data-name=\"cellular signal strength icon\"></i>\n<i class=\"icon-wifi text-[13px]\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"></i>\n<div class=\"w-5 h-2.5 border border-[#242120]/60 rounded-xs p-0.5 flex items-center\" data-kid=\"1-1-2-3\" data-name=\"battery level indicator\">\n<div class=\"w-full h-full bg-[#242120]/80 rounded-[1px]\" data-kid=\"1-1-2-3-1\" data-name=\"battery charge fill bar\"></div>\n</div>\n</div>\n</header>\n<!-- CONTENIDO PRINCIPAL: PORTADA GASTRONÓMICA (VISTA BASE) -->\n<main class=\"w-full px-6 pt-1 pb-4 flex-1 flex flex-col justify-between overflow-y-auto\" data-kid=\"1-2\" data-name=\"main restaurant cover view\">\n<!-- IDENTIDAD DE MARCA (56px) -->\n<div class=\"flex items-center justify-between py-2 border-b border-[#E7DDD2]/60 shrink-0\" data-kid=\"1-2-1\" data-name=\"restaurant brand identity bar\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"brand logo and name group\">\n<div class=\"w-10 h-10 rounded-full bg-[#8E292E] flex items-center justify-center text-[#E3BD73] shadow-xs ring-2 ring-[#C3934F]/30\" data-kid=\"1-2-1-1-1\" data-name=\"brand logo badge\">\n<i class=\"icon-flame text-lg\" data-kid=\"1-2-1-1-1-1\" data-name=\"flame icon inside logo\"></i>\n</div>\n<div data-kid=\"1-2-1-1-2\" data-name=\"brand name and tagline group\">\n<h1 class=\"font-cormorant text-2xl font-bold tracking-wider text-[#8E292E] leading-tight\" data-kid=\"1-2-1-1-2-1\" data-name=\"restaurant name heading\">CHIFA ASIA</h1>\n<p class=\"text-[10px] font-medium tracking-widest text-[#95692A] uppercase\" data-kid=\"1-2-1-1-2-2\" data-name=\"restaurant tagline subtitle\">Cocina Contemporánea</p>\n</div>\n</div>\n<div class=\"px-2.5 py-1 rounded-full bg-[#F5EFE7] border border-[#E7DDD2] flex items-center gap-1.5 text-[11px] font-semibold text-[#746F6A]\" data-kid=\"1-2-1-2\" data-name=\"restaurant open status pill\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-[#278063]\" data-kid=\"1-2-1-2-1\" data-name=\"open status indicator dot\"></span>\n<span data-kid=\"1-2-1-2-2\" data-name=\"open status text\">Abierto</span>\n</div>\n</div>\n<!-- SECCIÓN FOTOGRÁFICA CULINARIA (250px) -->\n<div class=\"my-3 relative w-full h-[240px] rounded-2xl overflow-hidden shadow-sm border border-[#E7DDD2] shrink-0\" data-kid=\"1-2-2\" data-name=\"culinary hero photo card\">\n<img alt=\"DΛVΞ GΛRCIΛ on Pexels\" class=\"w-full h-full object-cover object-center\" data-kid=\"1-2-2-1\" data-name=\"featured dish photography\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/37743302/pexels-photo-37743302.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=720&amp;q=80\"/>\n<!-- Vignette sutil y rótulo de plato -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#151718]/85 via-[#151718]/30 to-transparent flex flex-col justify-end p-4\" data-kid=\"1-2-2-2\" data-name=\"hero photo caption overlay\">\n<span class=\"inline-flex items-center self-start px-2 py-0.5 rounded-full bg-[#C3934F]/90 text-white text-[10px] font-semibold tracking-wide uppercase mb-1\" data-kid=\"1-2-2-2-1\" data-name=\"dish specialty badge\">\n          Especialidad Wok\n        </span>\n<h2 class=\"font-cormorant text-xl font-semibold text-white leading-tight\" data-kid=\"1-2-2-2-2\" data-name=\"featured dish name heading\">Tallarín Saltado Especial</h2>\n<p class=\"text-xs text-[#FCF9F5]/80 font-normal\" data-kid=\"1-2-2-2-3\" data-name=\"featured dish description text\">Fusión tradicional peruano-china al fuego vivo</p>\n</div>\n</div>\n<!-- TÍTULO EDITORIAL -->\n<div class=\"text-center px-2 mb-3 shrink-0\" data-kid=\"1-2-3\" data-name=\"editorial headline section\">\n<h3 class=\"font-cormorant text-2xl font-semibold text-[#242120] leading-snug\" data-kid=\"1-2-3-1\" data-name=\"editorial section main headline\">Una tradición culinaria que enamora</h3>\n<p class=\"text-xs text-[#746F6A] mt-1 font-normal\" data-kid=\"1-2-3-2\" data-name=\"editorial section subtitle text\">Explora nuestra carta, reserva tu mesa o pide a domicilio con la máxima frescura.</p>\n</div>\n<!-- BOTONES DE ACCESO BASE -->\n<div class=\"space-y-2.5 w-full shrink-0\" data-kid=\"1-2-4\" data-name=\"primary action buttons section\">\n<!-- BOTÓN PRINCIPAL: EXPLORAR COMO INVITADO (52px) -->\n<button class=\"w-full h-[50px] px-5 rounded-xl bg-[#8E292E] hover:bg-[#771F24] active:scale-[0.99] text-white font-semibold text-sm flex items-center justify-between shadow-sm transition-all duration-150 cursor-pointer\" data-kid=\"1-2-4-1\" data-name=\"explore menu as guest button\" id=\"btn-guest-explore\" type=\"button\">\n<span class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-1\" data-name=\"button label with icon\">\n<i class=\"icon-utensils text-base text-[#E3BD73]\" data-kid=\"1-2-4-1-1-1\" data-name=\"utensils icon\"></i>\n<span data-kid=\"1-2-4-1-1-2\" data-name=\"button label text\">Explorar carta como invitado</span>\n</span>\n<i class=\"icon-chevron-right text-base text-white/80\" data-kid=\"1-2-4-1-2\" data-name=\"chevron right direction icon\"></i>\n</button>\n<!-- FILA SECUNDARIA: INICIAR SESIÓN CON TU CUENTA -->\n<button class=\"w-full h-[52px] px-4 rounded-xl bg-white hover:bg-[#F5EFE7]/60 active:scale-[0.99] border border-[#E7DDD2] flex items-center justify-between text-left transition-all duration-150 shadow-2xs cursor-pointer group\" data-kid=\"1-2-4-2\" data-name=\"login with account button\" id=\"btn-open-login\" type=\"button\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-4-2-1\" data-name=\"button label group with user icon\">\n<div class=\"w-8 h-8 rounded-lg bg-[#F5EFE7] border border-[#E7DDD2] flex items-center justify-center text-[#8E292E] group-hover:bg-[#8E292E] group-hover:text-white transition-colors duration-150\" data-kid=\"1-2-4-2-1-1\" data-name=\"user icon badge\">\n<i class=\"icon-user text-sm\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"user icon\"></i>\n</div>\n<div data-kid=\"1-2-4-2-1-2\" data-name=\"button title and description\">\n<div class=\"text-xs font-semibold text-[#242120] leading-tight\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"button primary title text\">Iniciar sesión con tu cuenta</div>\n<div class=\"text-[10px] text-[#746F6A]\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"button description subtitle\">Ver pedidos, mesa activa y recompensas</div>\n</div>\n</div>\n<div class=\"w-6 h-6 rounded-full bg-[#FCF9F5] flex items-center justify-center text-[#746F6A] group-hover:text-[#8E292E] group-hover:translate-x-0.5 transition-all\" data-kid=\"1-2-4-2-2\" data-name=\"button chevron container\">\n<i class=\"icon-chevron-right text-xs\" data-kid=\"1-2-4-2-2-1\" data-name=\"chevron right icon\"></i>\n</div>\n</button>\n<!-- ENLACE DE REGISTRO -->\n<div class=\"text-center pt-0.5 pb-1\" data-kid=\"1-2-4-3\" data-name=\"sign-up prompt section\">\n<span class=\"text-xs text-[#746F6A]\" data-kid=\"1-2-4-3-1\" data-name=\"no account prompt text\">¿Aún no tienes cuenta?</span>\n<button class=\"text-xs font-bold text-[#8E292E] hover:underline ml-1 cursor-pointer\" data-kid=\"1-2-4-3-2\" data-name=\"create new account link button\" type=\"button\">\n          Crear cuenta nueva\n        </button>\n</div>\n</div>\n</main>\n<!-- HOME INDICATOR (34px) -->\n<footer class=\"w-full h-7 flex items-center justify-center pointer-events-none shrink-0\" data-kid=\"1-3\" data-name=\"phone home indicator footer\">\n<div class=\"w-32 h-1 bg-[#242120]/25 rounded-full\" data-kid=\"1-3-1\" data-name=\"home indicator bar\"></div>\n</footer>\n<!-- ============================================================== -->\n<!-- MODAL BOTTOM SHEET INTERACTIVO (LOGIN ON-DEMAND) -->\n<!-- ============================================================== -->\n<!-- BACKDROP OSCURO SEMITRANSPARENTE (Visible inicialmente para mostrar el panel) -->\n<div class=\"absolute inset-0 bg-[#151718]/65 backdrop-blur-[2px] z-30 opacity-100 transition-opacity duration-250 cursor-pointer\" data-kid=\"1-4\" data-name=\"modal dark backdrop overlay\" id=\"login-backdrop\" title=\"Toca para cerrar el panel\"></div>\n<!-- HOJA DESLIZANTE DE INICIO DE SESIÓN (Abierta inicialmente para evaluar diseño) -->\n<div class=\"absolute inset-x-0 bottom-0 z-40 bg-[#FCF9F5] rounded-t-[28px] border-t border-[#E7DDD2] shadow-2xl px-6 pt-3 pb-6 transform translate-y-0 opacity-100 transition-all duration-300 max-h-[92%] flex flex-col justify-between\" data-kid=\"1-5\" data-name=\"login bottom sheet modal\" id=\"login-modal-sheet\">\n<!-- BARRA INDICADORA SUPERIOR (DRAG HANDLE) -->\n<div class=\"w-full flex justify-center mb-2\" data-kid=\"1-5-1\" data-name=\"modal drag handle wrapper\">\n<div class=\"w-10 h-1 bg-[#E7DDD2] rounded-full\" data-kid=\"1-5-1-1\" data-name=\"modal drag handle bar\"></div>\n</div>\n<!-- CABECERA DEL MODAL -->\n<div class=\"flex items-center justify-between pb-3 border-b border-[#E7DDD2]/60\" data-kid=\"1-5-2\" data-name=\"modal header section\">\n<div data-kid=\"1-5-2-1\" data-name=\"modal header title block\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-5-2-1-1\" data-name=\"modal title with logo\">\n<div class=\"w-7 h-7 rounded-full bg-[#8E292E] flex items-center justify-center text-[#E3BD73]\" data-kid=\"1-5-2-1-1-1\" data-name=\"mini brand logo badge\">\n<i class=\"icon-flame text-xs\" data-kid=\"1-5-2-1-1-1-1\" data-name=\"flame icon in mini logo\"></i>\n</div>\n<h3 class=\"font-cormorant text-2xl font-bold text-[#242120] leading-none\" data-kid=\"1-5-2-1-1-2\" data-name=\"modal title heading\">Iniciar sesión</h3>\n</div>\n<p class=\"text-[11px] text-[#746F6A] mt-1 font-normal\" data-kid=\"1-5-2-1-2\" data-name=\"modal subtitle text\">Accede con tus credenciales de Chifa ASIA</p>\n</div>\n<button aria-label=\"Cerrar modal\" class=\"w-8 h-8 rounded-full bg-[#F5EFE7] hover:bg-[#E7DDD2] active:scale-95 text-[#746F6A] hover:text-[#242120] flex items-center justify-center cursor-pointer transition-colors\" data-kid=\"1-5-2-2\" data-name=\"modal close button\" id=\"btn-close-login\" title=\"Cerrar y volver a la portada\" type=\"button\">\n<i class=\"icon-x text-base\" data-kid=\"1-5-2-2-1\" data-name=\"cross close icon\"></i>\n</button>\n</div>\n<!-- FORMULARIO DE ACCESO PROFESIONAL (SIN BLOQUE DEMO) -->\n<form class=\"mt-3 space-y-3.5\" data-kid=\"1-5-3\" data-name=\"login credentials form\" id=\"login-form\" onsubmit=\"event.preventDefault(); handleLoginSubmit();\">\n<!-- CAMPO: CORREO ELECTRÓNICO -->\n<div data-kid=\"1-5-3-1\" data-name=\"email input field block\">\n<div class=\"flex items-center justify-between mb-1\" data-kid=\"1-5-3-1-1\" data-name=\"email field label and status row\">\n<label class=\"block text-xs font-semibold text-[#242120]\" data-kid=\"1-5-3-1-1-1\" data-name=\"email field label\" for=\"input-email\">\n            Correo electrónico\n          </label>\n<span class=\"text-[10px] font-semibold text-[#278063] flex items-center gap-1\" data-dynamic=\"true\" data-kid=\"1-5-3-1-1-2\" data-name=\"email validation status badge\" data-reason=\"innerHTML and className rewritten by email input listener\" id=\"email-status-badge\">\n<i class=\"icon-check text-xs\" data-kid=\"1-5-3-1-1-2-1\" data-name=\"checkmark icon in email status\"></i> Formato válido\n          </span>\n</div>\n<div class=\"relative flex items-center\" data-kid=\"1-5-3-1-2\" data-name=\"email input row\">\n<span class=\"absolute left-3.5 text-[#746F6A] pointer-events-none\" data-kid=\"1-5-3-1-2-1\" data-name=\"email field icon wrapper\">\n<i class=\"icon-mail text-[15px]\" data-kid=\"1-5-3-1-2-1-1\" data-name=\"mail icon\"></i>\n</span>\n<input class=\"w-full h-[48px] pl-10 pr-9 rounded-xl bg-white border border-[#E4DFD7] text-sm text-[#242120] placeholder-[#746F6A]/60 focus:outline-hidden focus:border-[#8E292E] focus:ring-1 focus:ring-[#8E292E] transition-all shadow-2xs\" data-kid=\"1-5-3-1-2-2\" data-name=\"email input field\" id=\"input-email\" placeholder=\"ejemplo@correo.com\" required=\"\" type=\"email\" value=\"ana@example.com\"/>\n<span class=\"absolute right-3 text-[#278063]\" data-kid=\"1-5-3-1-2-3\" data-name=\"valid email check icon wrapper\">\n<i class=\"icon-check-circle text-sm\" data-kid=\"1-5-3-1-2-3-1\" data-name=\"checkmark circle icon\"></i>\n</span>\n</div>\n</div>\n<!-- CAMPO: CONTRASEÑA -->\n<div data-kid=\"1-5-3-2\" data-name=\"password input field block\">\n<div class=\"flex items-center justify-between mb-1\" data-kid=\"1-5-3-2-1\" data-name=\"password field label and forgot row\">\n<label class=\"block text-xs font-semibold text-[#242120]\" data-kid=\"1-5-3-2-1-1\" data-name=\"password field label\" for=\"input-password\">\n            Contraseña\n          </label>\n<button class=\"text-xs font-medium text-[#8E292E] hover:underline cursor-pointer\" data-kid=\"1-5-3-2-1-2\" data-name=\"forgot password link\" type=\"button\">\n            ¿Olvidaste tu contraseña?\n          </button>\n</div>\n<div class=\"relative flex items-center\" data-kid=\"1-5-3-2-2\" data-name=\"password input row\">\n<span class=\"absolute left-3.5 text-[#746F6A] pointer-events-none\" data-kid=\"1-5-3-2-2-1\" data-name=\"password field icon wrapper\">\n<i class=\"icon-lock text-[15px]\" data-kid=\"1-5-3-2-2-1-1\" data-name=\"lock icon\"></i>\n</span>\n<input class=\"w-full h-[48px] pl-10 pr-11 rounded-xl bg-white border border-[#E4DFD7] text-sm text-[#242120] placeholder-[#746F6A]/60 focus:outline-hidden focus:border-[#8E292E] focus:ring-1 focus:ring-[#8E292E] transition-all shadow-2xs\" data-dynamic=\"true\" data-kid=\"1-5-3-2-2-2\" data-name=\"password input field\" data-reason=\"type attribute toggled by show/hide password button\" id=\"input-password\" placeholder=\"••••••••••••\" required=\"\" type=\"password\" value=\"Chifa2026*\"/>\n<button class=\"absolute right-3 text-[#746F6A] hover:text-[#242120] p-1 cursor-pointer transition-colors\" data-kid=\"1-5-3-2-2-3\" data-name=\"show or hide password toggle button\" id=\"btn-toggle-password\" title=\"Mostrar u ocultar contraseña\" type=\"button\">\n<i class=\"icon-eye text-[16px]\" data-dynamic=\"true\" data-kid=\"1-5-3-2-2-3-1\" data-name=\"eye visibility icon\" data-reason=\"className swapped between eye and eye-off by toggle button\" id=\"eye-icon\"></i>\n</button>\n</div>\n<!-- MEDIDOR DINÁMICO DE COMPLEJIDAD (EN VIVO) -->\n<div class=\"mt-2 px-0.5\" data-kid=\"1-5-3-2-3\" data-name=\"password strength meter\">\n<div class=\"flex items-center justify-between text-[11px] mb-1\" data-kid=\"1-5-3-2-3-1\" data-name=\"strength meter label row\">\n<span class=\"text-[#746F6A]\" data-kid=\"1-5-3-2-3-1-1\" data-name=\"strength meter label text\">Seguridad de contraseña:</span>\n<span class=\"font-semibold text-[#278063]\" data-dynamic=\"true\" data-kid=\"1-5-3-2-3-1-2\" data-name=\"password complexity level indicator\" data-reason=\"textContent and color className rewritten on password input\" id=\"strength-label\">Complejidad: alta</span>\n</div>\n<div class=\"grid grid-cols-3 gap-1.5 h-1.5 w-full\" data-kid=\"1-5-3-2-3-2\" data-name=\"strength meter bars container\">\n<div class=\"h-full rounded-full bg-[#278063] transition-colors duration-200\" data-dynamic=\"true\" data-kid=\"1-5-3-2-3-2-1\" data-name=\"strength bar segment one\" data-reason=\"bg color className changed by password strength script\" id=\"bar-1\"></div>\n<div class=\"h-full rounded-full bg-[#278063] transition-colors duration-200\" data-dynamic=\"true\" data-kid=\"1-5-3-2-3-2-2\" data-name=\"strength bar segment two\" data-reason=\"bg color className changed by password strength script\" id=\"bar-2\"></div>\n<div class=\"h-full rounded-full bg-[#278063] transition-colors duration-200\" data-dynamic=\"true\" data-kid=\"1-5-3-2-3-2-3\" data-name=\"strength bar segment three\" data-reason=\"bg color className changed by password strength script\" id=\"bar-3\"></div>\n</div>\n</div>\n</div>\n<!-- BOTÓN DE INICIO DE SESIÓN (52px) -->\n<div class=\"pt-1\" data-kid=\"1-5-3-3\" data-name=\"login submit button wrapper\">\n<button class=\"w-full h-[50px] rounded-xl bg-[#8E292E] hover:bg-[#771F24] active:scale-[0.99] text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm transition-all duration-150 cursor-pointer\" data-kid=\"1-5-3-3-1\" data-name=\"submit login button\" id=\"btn-submit-login\" type=\"submit\">\n<span data-dynamic=\"true\" data-kid=\"1-5-3-3-1-1\" data-name=\"submit button label\" data-reason=\"textContent replaced by handleLoginSubmit on submit\" id=\"login-btn-text\">Iniciar sesión</span>\n<i class=\"icon-arrow-right text-sm\" data-dynamic=\"true\" data-kid=\"1-5-3-3-1-2\" data-name=\"submit button direction icon\" data-reason=\"className and icon swapped by handleLoginSubmit\" id=\"login-btn-icon\"></i>\n</button>\n</div>\n<!-- ACCESO DIRECTO COMO INVITADO DENTRO DEL MODAL -->\n<div class=\"text-center pt-0.5\" data-kid=\"1-5-3-4\" data-name=\"modal guest access row\">\n<button class=\"text-xs font-semibold text-[#746F6A] hover:text-[#8E292E] transition-colors cursor-pointer\" data-kid=\"1-5-3-4-1\" data-name=\"continue as guest link\" id=\"modal-guest-btn\" type=\"button\">\n          O continuar como invitado sin cuenta →\n        </button>\n</div>\n<!-- PIE DE SEGURIDAD Y PRIVACIDAD -->\n<div class=\"flex items-center justify-center gap-1.5 text-[10px] text-[#746F6A] pt-1 border-t border-[#E7DDD2]/40\" data-kid=\"1-5-3-5\" data-name=\"security and privacy footer\">\n<i class=\"icon-shield-check text-xs text-[#278063]\" data-kid=\"1-5-3-5-1\" data-name=\"shield check security icon\"></i>\n<span data-kid=\"1-5-3-5-2\" data-name=\"encryption and privacy notice text\">Acceso encriptado y seguro · Datos protegidos por TLS</span>\n</div>\n</form>\n</div>\n<!-- CONTROL FLOTANTE DISCRETO PARA ALTERNAR EN CANVAS -->\n<div class=\"absolute top-3 right-3 z-50\" data-kid=\"1-6\" data-name=\"modal toggle floating control wrapper\">\n<button class=\"px-2.5 py-1 rounded-full bg-[#242120]/80 hover:bg-[#242120] text-white text-[10px] font-medium tracking-wide shadow-md cursor-pointer flex items-center gap-1 transition-all\" data-kid=\"1-6-1\" data-name=\"toggle sheet visible button\" id=\"btn-toggle-sheet-state\" title=\"Alternar entre vista de portada y modal de login\" type=\"button\">\n<i class=\"icon-layers text-xs\" data-kid=\"1-6-1-1\" data-name=\"layers stack icon\"></i>\n<span data-dynamic=\"true\" data-kid=\"1-6-1-2\" data-name=\"toggle button label\" data-reason=\"textContent switched between 'Ocultar Modal' and 'Ver Modal' by script\" id=\"toggle-sheet-label\">Ocultar Modal</span>\n</button>\n</div>\n</div>\n<!-- SCRIPT DE MICROINTERACCIONES COMPLETAS -->\n<script>\n  (function() {\n    const btnOpen = document.getElementById('btn-open-login');\n    const btnClose = document.getElementById('btn-close-login');\n    const backdrop = document.getElementById('login-backdrop');\n    const sheet = document.getElementById('login-modal-sheet');\n    const btnTogglePreview = document.getElementById('btn-toggle-sheet-state');\n    const toggleLabel = document.getElementById('toggle-sheet-label');\n    const inputPassword = document.getElementById('input-password');\n    const inputEmail = document.getElementById('input-email');\n    const emailStatusBadge = document.getElementById('email-status-badge');\n    const btnTogglePassword = document.getElementById('btn-toggle-password');\n    const eyeIcon = document.getElementById('eye-icon');\n    const strengthLabel = document.getElementById('strength-label');\n    const bar1 = document.getElementById('bar-1');\n    const bar2 = document.getElementById('bar-2');\n    const bar3 = document.getElementById('bar-3');\n    const btnSubmit = document.getElementById('btn-submit-login');\n    const btnText = document.getElementById('login-btn-text');\n    const btnIcon = document.getElementById('login-btn-icon');\n    const modalGuestBtn = document.getElementById('modal-guest-btn');\n\n    let isOpen = true;\n\n    function openModal() {\n      isOpen = true;\n      sheet.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');\n      sheet.classList.add('translate-y-0', 'opacity-100');\n      backdrop.classList.remove('opacity-0', 'pointer-events-none');\n      backdrop.classList.add('opacity-100');\n      if (toggleLabel) toggleLabel.textContent = 'Ocultar Modal';\n    }\n\n    function closeModal() {\n      isOpen = false;\n      sheet.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');\n      sheet.classList.remove('translate-y-0', 'opacity-100');\n      backdrop.classList.add('opacity-0', 'pointer-events-none');\n      backdrop.classList.remove('opacity-100');\n      if (toggleLabel) toggleLabel.textContent = 'Ver Modal';\n    }\n\n    if (btnOpen) btnOpen.addEventListener('click', openModal);\n    if (btnClose) btnClose.addEventListener('click', closeModal);\n    if (backdrop) backdrop.addEventListener('click', closeModal);\n    if (modalGuestBtn) modalGuestBtn.addEventListener('click', closeModal);\n\n    if (btnTogglePreview) {\n      btnTogglePreview.addEventListener('click', function() {\n        if (isOpen) {\n          closeModal();\n        } else {\n          openModal();\n        }\n      });\n    }\n\n    // Toggle Password Visibility\n    if (btnTogglePassword && inputPassword && eyeIcon) {\n      btnTogglePassword.addEventListener('click', function() {\n        const isPassword = inputPassword.getAttribute('type') === 'password';\n        inputPassword.setAttribute('type', isPassword ? 'text' : 'password');\n        eyeIcon.className = isPassword ? 'icon-eye-off text-[16px]' : 'icon-eye text-[16px]';\n      });\n    }\n\n    // Email live feedback\n    if (inputEmail && emailStatusBadge) {\n      inputEmail.addEventListener('input', function() {\n        const val = inputEmail.value.trim();\n        const isValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(val);\n        if (isValid) {\n          emailStatusBadge.innerHTML = '<i class=\"icon-check text-xs\"></i> Formato válido';\n          emailStatusBadge.className = 'text-[10px] font-semibold text-[#278063] flex items-center gap-1';\n        } else {\n          emailStatusBadge.innerHTML = 'Formato incompleto';\n          emailStatusBadge.className = 'text-[10px] font-semibold text-[#746F6A] flex items-center gap-1';\n        }\n      });\n    }\n\n    // Password strength logic\n    if (inputPassword) {\n      inputPassword.addEventListener('input', function() {\n        const val = inputPassword.value;\n        const len = val.length;\n        if (len === 0) {\n          strengthLabel.textContent = 'Complejidad: pendiente';\n          strengthLabel.className = 'font-semibold text-[#746F6A]';\n          bar1.className = 'h-full rounded-full bg-[#E7DDD2]';\n          bar2.className = 'h-full rounded-full bg-[#E7DDD2]';\n          bar3.className = 'h-full rounded-full bg-[#E7DDD2]';\n        } else if (len < 6) {\n          strengthLabel.textContent = 'Complejidad: baja';\n          strengthLabel.className = 'font-semibold text-[#C35350]';\n          bar1.className = 'h-full rounded-full bg-[#C35350]';\n          bar2.className = 'h-full rounded-full bg-[#E7DDD2]';\n          bar3.className = 'h-full rounded-full bg-[#E7DDD2]';\n        } else if (len < 10) {\n          strengthLabel.textContent = 'Complejidad: media';\n          strengthLabel.className = 'font-semibold text-[#C3934F]';\n          bar1.className = 'h-full rounded-full bg-[#C3934F]';\n          bar2.className = 'h-full rounded-full bg-[#C3934F]';\n          bar3.className = 'h-full rounded-full bg-[#E7DDD2]';\n        } else {\n          strengthLabel.textContent = 'Complejidad: alta';\n          strengthLabel.className = 'font-semibold text-[#278063]';\n          bar1.className = 'h-full rounded-full bg-[#278063]';\n          bar2.className = 'h-full rounded-full bg-[#278063]';\n          bar3.className = 'h-full rounded-full bg-[#278063]';\n        }\n      });\n    }\n\n    // Submit animation simulation\n    window.handleLoginSubmit = function() {\n      if (btnText && btnIcon) {\n        btnText.textContent = 'Iniciando sesión...';\n        btnIcon.className = 'icon-loader-2 animate-spin text-sm';\n        setTimeout(function() {\n          btnText.textContent = '¡Bienvenido a Chifa ASIA!';\n          btnIcon.className = 'icon-check text-sm';\n          setTimeout(closeModal, 800);\n        }, 1200);\n      }\n    };\n  })();\n</script>\n",
