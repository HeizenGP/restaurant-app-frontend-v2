@startuml
title ARQ-FE-01 — Dos aplicaciones Flutter
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

node "customer_app\nAndroid" as Customer {
 component "Cliente e invitado\nM01–M04" as CustomerUI
}
node "staff_app\nAndroid + Flutter Web" as Staff {
 component "Shell por capacidades" as Shell
 component "Mozo" as Waiter
 component "Cocina" as Kitchen
 component "Caja" as Cashier
 component "Panel administrativo\nFlutter Web" as Admin
 Shell --> Waiter
 Shell --> Kitchen
 Shell --> Cashier
 Shell --> Admin
}
package "Paquetes compartidos" {
 component "foundation" as Foundation
 component "rest_api" as Rest
 component "auth_session" as Auth
 component "design_system" as Design
}
cloud "FastAPI REST\n/api/v1" as API
Customer --> Rest
Staff --> Rest
Customer ..> Foundation
Staff ..> Foundation
Customer ..> Auth
Staff ..> Auth
Customer ..> Design
Staff ..> Design
Rest --> API : HTTPS / JSON
note bottom of Admin
  Es una vista de staff_app, no una tercera aplicación.
  Los permisos se revalidan en FastAPI.
end note
@enduml
