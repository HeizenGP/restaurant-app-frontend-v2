@startuml
title ARQ-BE-01 — FastAPI modular y transacción compartida
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

actor "Apps Flutter" as Client
component "FastAPI / REST\n/api/v1" as API
component "Bootstrap / DI\ny UoW compartida" as Boot

package "Módulos hexagonales (puertos propios)" {
 component "M01 Accesos" as M01
 component "M02 Catálogo / stock" as M02
 component "M03 Mesas" as M03
 component "M04 Pedidos\nConfirmOrder" as M04
 component "M05 Cocina" as M05
 component "M06 Pagos / anticipos" as M06
 component "M07 Entrega / cierre" as M07
}
package "Persistencia (adaptadores separados)" {
 component "Repositorio M01" as R01
 component "Repositorio M02" as R02
 component "Repositorio M03" as R03
 component "Repositorio M04" as R04
 component "Repositorio M05" as R05
 component "Repositorio M06" as R06
 component "Repositorio M07" as R07
}
database "PostgreSQL\ntransacción única" as DB
component "Adaptador manual\nde anticipo simulado" as Manual
Client --> API
API --> M01
API --> M04
API --> M07
API --> M06
Boot ..> API : compone
Boot ..> M04 : UoW
M04 --> M02 : puerto stock
M04 --> M03 : puerto mesa
M04 --> M06 : puerto anticipo
M04 --> M05 : puerto comanda
M07 --> M04 : puerto estado/cierre
M07 --> M06 : puerto saldo
M06 --> Manual : verificación y abono único
M01 ..> R01 : puerto M01
M02 ..> R02 : puerto M02
M03 ..> R03 : puerto M03
M04 ..> R04 : puerto M04
M05 ..> R05 : puerto M05
M06 ..> R06 : puerto M06
M07 ..> R07 : puerto M07
R01 --> DB
R02 --> DB
R03 --> DB
R04 --> DB
R05 --> DB
R06 --> DB
R07 --> DB
note bottom of M04
  Una UoW: autorización, stock, anticipo
  ya registrado, pedido y comanda.
  Commit único o rollback completo.
  Puertos sin acceder a tablas ajenas.
end note
@enduml
