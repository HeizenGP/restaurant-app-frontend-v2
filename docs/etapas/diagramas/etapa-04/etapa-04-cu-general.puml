@startuml
title CU-00 — Casos de uso generales | Chifa ASIA
left to right direction

skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 18
skinparam defaultFontSize 12

actor "Cliente" as C
actor "Mozo" as M

rectangle "Chifa ASIA — Sistema de gestión de pedidos" {
  usecase "Consultar catálogo\n(M02)" as U1
  usecase "Realizar pedido\n(M03/M04)" as U2
  usecase "Consultar estado\ndel pedido (M04)" as U3
  usecase "Atender pedidos\nen mesa (M03/M04/M07)" as U4
  usecase "Aprobar solicitudes\nlocales de la app (M04)" as U5

  usecase "Gestionar comandas\n(M05)" as U6
  usecase "Registrar cobros\n(M06)" as U7
  usecase "Administrar restaurante\n(M01-M03)" as U8
  usecase "Aprobar pedidos\nde recojo/delivery (M04)" as U9
  usecase "Verificar anticipos\n(M06)" as U10

  ' Dos columnas de cinco objetivos: solo restricciones visuales.
  U1 -[hidden]down- U2
  U2 -[hidden]down- U3
  U3 -[hidden]down- U4
  U4 -[hidden]down- U5

  U6 -[hidden]down- U7
  U7 -[hidden]down- U8
  U8 -[hidden]down- U9
  U9 -[hidden]down- U10

  U1 -[hidden]right- U6
  U2 -[hidden]right- U7
  U3 -[hidden]right- U8
  U4 -[hidden]right- U9
  U5 -[hidden]right- U10
}

actor "Personal de cocina" as K
actor "Cajero" as J
actor "Administrador" as A
actor "Super Administrador" as S

C -right- U1
C -right- U2
C -right- U3

M -right- U4
M -right- U5
A -- U5

U6 -right- K
U7 -right- J
U8 -right- A
U9 -right- A
U10 -right- A
U8 -right- S

note right of S
  RN-03: acceso global.
end note

legend bottom
  Vista general: los casos específicos se detallan en CU-01 a CU-07.
  M07: responsables de recojo, delivery y cierre aún por ratificar.
endlegend
@enduml
