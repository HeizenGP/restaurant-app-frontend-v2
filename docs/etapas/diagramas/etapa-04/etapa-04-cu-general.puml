
@startuml
title CU-00 — Casos de uso generales | Chifa ASIA

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

actor Cliente as C
actor Mozo as M
actor "Personal de cocina" as K
actor Cajero as J
actor Administrador as A
actor "Superadministrador" as S

rectangle "Sistema Chifa ASIA" {

  package "Atención del restaurante" {
    usecase "Acceder o continuar\ncomo invitado (M01)" as UC1
    usecase "Consultar catálogo y\nsolicitar pedidos (M02/M04)" as UC2
    usecase "Atender pedidos en\nmesa (M03/M04/M07)" as UC3
    usecase "Preparar comandas\nconfirmadas (M05)" as UC4
  }

  package "Administración y caja" {
    usecase "Administrar usuarios,\nproductos y mesas (M01-M03)" as UC5
    usecase "Revisar pedidos y\nverificar anticipos (M04/M06)" as UC6
    usecase "Registrar cobros\n(M06)" as UC7
  }
}

C -- UC1
C -- UC2

M -- UC3
K -- UC4

A -- UC5
A -- UC6

J -- UC7

S -- UC5

legend bottom
  El Superadministrador tiene acceso a todas las funciones.
  Se muestra una asociación representativa para evitar
  conexiones redundantes.

  La verificación de anticipos no concede acceso a Caja.
  Responsables de recojo, delivery y cierre: por ratificar.
endlegend

@enduml
