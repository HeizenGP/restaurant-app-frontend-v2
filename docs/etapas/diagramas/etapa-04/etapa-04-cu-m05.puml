@startuml
left to right direction
title CU-05 — M05 Cocina y comandas
skinparam shadowing false
actor "Personal de cocina" as K
rectangle "M05 — Cocina y comandas" {
  usecase "RF-M05-01\nHabilitar comanda tras confirmación" as U1
  usecase "RF-M05-02\nConsultar detalle de comanda" as U2
  usecase "RF-M05-03\nMarcar En preparación" as U3
  usecase "RF-M05-04\nMarcar Listo" as U4
}
K -- U2
K -- U3
K -- U4
note bottom of U1
  Condición automática del sistema:
  comanda solo para pedido confirmado.
end note
@enduml
