@startuml
title CU-04 — M04 | Pedidos y aprobación
left to right direction
skinparam shadowing false
skinparam linetype ortho
actor "Cliente" as C
actor "Mozo" as M
actor "Administrador" as A
rectangle "M04 — Gestión de pedidos" {
  usecase "Elegir modalidad\n(RF-M04-01)" as U1
  usecase "Enviar solicitud desde app\n(RF-M04-02)" as U2
  usecase "Registrar pedido presencial\n(RF-M04-03)" as U3
  usecase "Registrar pedido por\nllamada/WhatsApp\n(RF-M04-04)" as U4
  usecase "Registrar datos del pedido\n(RF-M04-05)" as U5
  usecase "Revisar y aprobar/rechazar\napp local (RF-M04-06)" as U6
  usecase "Revisar y aprobar/rechazar\napp recojo/delivery\n(RF-M04-07)" as U7
  usecase "Confirmar pedido\n(RF-M04-09)" as U9
  usecase "Consultar estado del pedido\n(RF-M04-10)" as U10
  usecase "Calcular importe total\n(RF-M04-11)" as U11
}
C -- U1
C -- U2
C -- U10
M -- U3
M -- U6
M -- U9
A -- U4
A -- U6
A -- U7
A -- U9
U2 .> U5 : <<include>>
U3 .> U5 : <<include>>
U4 .> U5 : <<include>>
U5 .> U11 : <<include>>
note right of U7
  RF-M04-08: si una solicitud de app se
  rechaza (U6 o U7), informar rechazo,
  impedir confirmación y NO emitir comanda.
end note
note bottom of U9
  Solo confirmar con autorización aplicable,
  productos habilitados y stock suficiente.
  Local por Mozo: sin segunda aprobación
  y sin anticipo; local por app: mesa verificada
  por Mozo o Administrador.
  Recojo/delivery: 50 % verificado por Admin.
  Descuento de stock único al confirmar
  y comanda solo tras confirmación.
end note
@enduml
