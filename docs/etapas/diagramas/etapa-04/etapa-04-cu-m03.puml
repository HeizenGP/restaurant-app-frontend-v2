@startuml
title CU-03 — M03 | Gestión de mesas
left to right direction
skinparam shadowing false
skinparam linetype ortho
actor "Cliente" as C
actor "Mozo" as M
actor "Administrador" as A
rectangle "M03 — Mesas" {
  usecase "Registrar y actualizar\nmesas/distribución\n(RF-M03-01)" as U1
  usecase "Consultar mesas\ndisponibles en app\n(RF-M03-02)" as U2
  usecase "Asociar mesa al pedido\nde consumo en local\n(RF-M03-03)" as U3
  usecase "Consultar/actualizar\nocupación de mesas\n(RF-M03-04)" as U4
}
A -- U1
C -- U2
C -- U3
M -- U3
M -- U4
A -- U4
note bottom of U4
  Prioridad RF-M03-04: SHOULD (aprobada).
  Actualizar ocupación no implica por sí solo
  permiso para liberar mesas.
  Los permisos específicos de liberación
  deben constar en la línea base de negocio.
end note
@enduml
