@startuml
title FL-01 - Chifa ASIA: flujo principal de pedidos
skinparam shadowing false
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #44546A
skinparam activityDiamondBackgroundColor #F1F5F9
skinparam activityDiamondBorderColor #44546A

start
:Cliente desea realizar un pedido;

if (¿Modalidad de consumo?) then (En local)
  if (¿Canal de atención?) then (Mozo)
    :Mozo atiende al cliente;
    :Registra productos y mesa;
  else (Aplicación)
    :Cliente ingresa, se registra o continúa como invitado;
    :Selecciona mesa y productos;
    :Envía solicitud;
    :Mozo o Administrador verifica la mesa;
    if (¿Solicitud aprobada?) then (Sí)
      :Pedido presencial aprobado;
    else (No)
      :Informar rechazo al cliente;
      stop
    endif
  endif
else (Recojo o delivery)
  if (¿Tipo de pedido?) then (Recojo)
    :Elegir recojo en local;
  else (Delivery)
    :Registrar dirección de entrega;
  endif

  if (¿Canal de pedido?) then (Aplicación)
    :Cliente ingresa, se registra o continúa como invitado;
    :Selecciona productos y envía solicitud;
    :Administrador revisa la solicitud;
    if (¿Administrador aprueba?) then (Sí)
      :Solicitud aprobada;
    else (No)
      :Informar rechazo al cliente;
      stop
    endif
  else (Llamada o WhatsApp)
    if (¿Canal externo?) then (Llamada)
      :Cliente realiza una llamada;
    else (WhatsApp)
      :Cliente escribe por WhatsApp;
    endif
    :Administrador registra y valida el pedido;
  endif
endif

:Verificar disponibilidad y cantidad de stock;
if (¿Productos disponibles y stock suficiente?) then (Sí)
  if (¿Consumo en local?) then (Sí)
    :Confirmar pedido presencial;
  else (Recojo o delivery)
    :Solicitar anticipo del 50 %;
    :Administrador verifica el pago;
    if (¿Anticipo confirmado?) then (Sí)
      :Confirmar pedido de recojo o delivery;
    else (No)
      :Mantener pedido pendiente;
      :No enviar comanda a cocina;
      stop
    endif
  endif
  :Descontar stock al confirmar el pedido;
  :Enviar comanda directamente a cocina;
else (No)
  :Informar falta de stock;
  :No confirmar el pedido;
  stop
endif

:Personal de cocina recibe la comanda;
:Actualizar estado a En preparación;
:Preparar productos;
:Actualizar estado a Listo;

if (¿Modalidad?) then (En local)
  :Mozo sirve en mesa;
  :Caja registra cobro;
else (Recojo o delivery)
  if (¿Tipo de entrega?) then (Recojo)
    :Registrar recojo en el local;
  else (Delivery)
    :Registrar entrega a domicilio;
  endif
  :Caja registra el 50 % restante;
endif

:Cerrar pedido;
stop
@enduml
